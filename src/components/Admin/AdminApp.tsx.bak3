    );
  };

  const renderReports = () => (
    <div className="space-y-6">
      <div className="bg-white rounded-xl shadow p-6">
        <h3 className="font-semibold text-rose-700 mb-4">Hesabat yaratma</h3>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Hesabat növü</label>
            <div className="flex flex-wrap gap-2">
              {['Günlük', 'Həftəlik', 'Aylıq', 'Rüblük'].map(t => (
                <button key={t} onClick={() => setReportType(t)} className={`px-3 py-1.5 rounded-lg text-sm font-medium transition ${reportType === t ? 'bg-rose-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>{t}</button>
              ))}
            </div>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Başlanğıc tarixi</label>
            <input type="date" defaultValue="2025-10-01" className="border rounded-lg px-3 py-1.5 text-sm w-full" />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Bitiş tarixi</label>
            <input type="date" defaultValue="2025-10-28" className="border rounded-lg px-3 py-1.5 text-sm w-full" />
          </div>
        </div>
        <div className="flex gap-3">
          <button className="flex items-center gap-2 bg-rose-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-rose-700 transition"><Download size={16} />PDF İxrac et</button>
          <button className="flex items-center gap-2 bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition"><Download size={16} />Excel İxrac et</button>
        </div>
      </div>

      <div className="bg-white rounded-xl shadow p-6">
        <h3 className="font-semibold text-gray-700 mb-3">Hesabat önizləmə - {reportType}</h3>
        <div className="border-2 border-dashed border-gray-200 rounded-xl p-8 text-center text-gray-400">
          <FileText size={48} className="mx-auto mb-3 opacity-50" />
          <p className="text-lg font-medium">Hesabat hazırdır</p>
          <p className="text-sm mt-1">Yuxarıdakı düymələrə klikləyərək PDF və ya Excel formatında yükləyə bilərsiniz</p>
          <div className="mt-6 text-left max-w-md mx-auto text-sm text-gray-500 space-y-1">
            <p>Ümumi istifadəçilər: {adminStats.totalUsers.toLocaleString()}</p>
            <p>Aktiv istifadəçilər: {adminStats.activeUsers.toLocaleString()}</p>
            <p>Aylıq ziyarətlər: {adminStats.monthlyVisits.toLocaleString()}</p>
            <p>Tədbirlər: {adminStats.todayActiveEvents}</p>
            <p>Verilmiş xallar: {adminStats.pointsIssued.toLocaleString()}</p>
            <p>Orta feedback: {adminStats.averageFeedbackScore}/10</p>
          </div>
        </div>
      </div>
    </div>
  );

  const sectionContent: Record<Section, () => React.ReactNode> = {
    overview: renderOverview,
    registrations: () => <RegistrationsPanel />,
    houses: renderHouses,
    events: renderEvents,
    qr: renderQR,
    feedback: renderFeedback,
    reports: renderReports,
  };

  return (
    <div className="min-h-screen bg-gray-50">
      <header className="sticky top-0 z-50 bg-gradient-to-r from-rose-700 via-red-600 to-rose-700 text-white shadow-lg">
        <div className="max-w-[1400px] mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <button onClick={onBack} className="p-2 rounded-lg hover:bg-white/10 transition"><ArrowLeft size={22} /></button>
            <div>
              <h1 className="text-lg lg:text-xl font-bold">Nazirlik İdarəetmə Paneli</h1>
              <p className="text-xs text-rose-200">Bütün Gənclər Evləri üzrə canlı statistika və analitika</p>
            </div>
          </div>
          <div className="flex items-center gap-2 text-sm">
            <span className="relative flex h-2.5 w-2.5"><span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" /><span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-400" /></span>
            <span className="hidden sm:inline text-rose-100">Canlı rejim</span>
            <span className="hidden md:inline text-xs text-rose-300 ml-1">Son yenilənmə: 2 dəq əvvəl</span>

            <div className="lg:hidden relative" data-testid="admin-mobile-nav">
              <button
                onClick={() => setMobileNav(!mobileNav)}
                aria-label="Menyu"
                className="p-2 rounded-lg hover:bg-white/10 transition"
              >
                {mobileNav ? <X size={22} /> : <Menu size={22} />}
              </button>
              {mobileNav && (
                <>
                  <div
                    className="fixed inset-0 z-40"
                    onClick={() => setMobileNav(false)}
                  />
                  <div className="absolute right-0 top-12 z-50 bg-white rounded-xl shadow-2xl border py-2 w-52 max-h-[70vh] overflow-y-auto">
                    {NAV_ITEMS.map(n => (
                      <button
                        key={n.id}
                        onClick={() => { setSection(n.id); setMobileNav(false); }}
                        className={`w-full flex items-center gap-2 px-4 py-2.5 text-sm ${section === n.id ? 'bg-rose-50 text-rose-700 font-semibold' : 'text-gray-600 hover:bg-gray-50'}`}
                      >
                        {n.icon}{n.label}
                      </button>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </header>

      <div className="max-w-[1400px] mx-auto flex">
        <aside className="hidden lg:block w-56 shrink-0 py-6 pr-4">
          <nav className="sticky top-24 space-y-1">
            {NAV_ITEMS.map(n => (
              <button key={n.id} onClick={() => setSection(n.id)} className={`w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition ${section === n.id ? 'bg-rose-600 text-white shadow' : 'text-gray-600 hover:bg-rose-50 hover:text-rose-700'}`}>
                {n.icon}{n.label}
              </button>
            ))}
          </nav>
        </aside>

        <main className="flex-1 min-w-0 px-4 py-6">
          {statsError && (
            <div className="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
              Statistika yüklənmədi: {statsError}
            </div>
          )}
          {statsLoading && !statsError && (
            <div className="mb-4 text-sm text-gray-500">Yüklənir...</div>
          )}
          <h2 className="text-lg font-bold text-gray-800 mb-4">
            {NAV_ITEMS.find(n => n.id === section)?.label}
          </h2>
          {sectionContent[section]()}
        </main>
      </div>
    </div>
  );
};

const ChartCard: React.FC<{ title: string; children: React.ReactNode }> = ({ title, children }) => (
  <div className="bg-white rounded-xl shadow p-4">
    <h3 className="text-sm font-semibold text-gray-700 mb-3">{title}</h3>
    {children}
  </div>
);

export default AdminApp;
