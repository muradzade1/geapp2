        />
      </ChartCard>

      <div className="bg-white rounded-xl shadow overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="bg-rose-50 text-rose-700">
            <tr>{['Ad','Şəhər','Hazırda','Giriş','Çıxış','Aktiv tədbirlər','İştirakçı','Feedback','Status'].map(h => <th key={h} className="px-3 py-2 text-left font-semibold whitespace-nowrap">{h}</th>)}</tr>
