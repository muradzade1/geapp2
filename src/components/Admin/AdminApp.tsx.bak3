                { value: d.users, color: '#ef4444', name: 'İstifadəçilər' },
                { value: d.events, color: '#3b82f6', name: 'Tədbirlər' },
                { value: d.visits, color: '#10b981', name: 'Ziyarətlər' },
              ]
            }))}
          />
        </ChartCard>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <ChartCard title="Yaş bölgüsü">
            <DonutChart
              data={chartData.ageDistribution.map((d, i) => ({
                label: d.age,
                value: d.count,
                color: PIE_COLORS[i % PIE_COLORS.length],
              }))}
            />
          </ChartCard>

          <ChartCard title="Cins bölgüsü">
            <DonutChart
              data={chartData.genderDistribution.map((d, i) => ({
                label: d.gender,
                value: d.count,
                color: ['#3b82f6', '#ec4899'][i],
              }))}
            />
          </ChartCard>
        </div>
      </div>
    </div>
  );

  const renderHouses = () => (
    <div className="space-y-6">
      <ChartCard title="Top 10 Gənclər Evi (bugünkü giriş)">
        <HorizontalBarChart
          data={chartData.topYouthHouses.map(d => ({ label: d.name, value: d.visitors }))}
