  const [reportType, setReportType] = useState('Günlük');

  const filteredScans = qrScans.filter(s => {
    if (qrFilterStatus !== 'Hamısı' && s.status !== qrFilterStatus) return false;
    if (qrFilterType !== 'Hamısı' && s.type !== qrFilterType) return false;
    return true;
  });

  const statCards = [
    { label: 'Ümumi qeydiyyatdan keçmiş istifadəçilər', value: adminStats.totalUsers.toLocaleString(), icon: <Users size={22} />, gradient: 'from-rose-500 to-red-600' },
    { label: 'Aktiv istifadəçilər', value: adminStats.activeUsers.toLocaleString(), icon: <UserCheck size={22} />, gradient: 'from-emerald-500 to-green-600' },
    { label: 'Hazırda Gənclər Evlərində olan gənclər', value: adminStats.currentVisitors.toLocaleString(), icon: <MapPin size={22} />, gradient: 'from-blue-500 to-sky-600' },
    { label: 'Bu gün giriş', value: adminStats.todayCheckIns.toLocaleString(), icon: <LogIn size={22} />, gradient: 'from-teal-500 to-cyan-600' },
    { label: 'Bu gün tədbir', value: adminStats.todayActiveEvents, icon: <Calendar size={22} />, gradient: 'from-amber-500 to-orange-600' },
    { label: 'Bu gün iştirakçı', value: adminStats.todayParticipants.toLocaleString(), icon: <Activity size={22} />, gradient: 'from-cyan-500 to-teal-600' },
    { label: 'Bu ay ziyarət', value: adminStats.monthlyVisits.toLocaleString(), icon: <TrendingUp size={22} />, gradient: 'from-pink-500 to-rose-600' },
    { label: 'Verilən xallar', value: adminStats.pointsIssued.toLocaleString(), icon: <Award size={22} />, gradient: 'from-yellow-500 to-amber-600' },
    { label: 'GəncKart istifadə', value: adminStats.gencKartUsage.toLocaleString(), icon: <CreditCard size={22} />, gradient: 'from-sky-500 to-blue-600' },
    { label: 'Feedback sayı', value: adminStats.feedbackCount.toLocaleString(), icon: <MessageSquare size={22} />, gradient: 'from-teal-500 to-emerald-600' },
    { label: 'Orta feedback', value: `${adminStats.averageFeedbackScore}/10`, icon: <Star size={22} />, gradient: 'from-orange-500 to-red-500' },
  ];

  const renderOverview = () => (
    <div className="space-y-6">
      <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {statCards.map((c, i) => (
          <div key={i} className={`bg-gradient-to-br ${c.gradient} rounded-xl p-4 text-white shadow-lg hover:shadow-xl transition-shadow`}>
            <div className="flex items-center justify-between mb-2 opacity-90">{c.icon}<span className="text-xs font-medium truncate ml-1">{c.label}</span></div>
            <p className="text-2xl lg:text-3xl font-bold">{c.value}</p>
          </div>
        ))}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <ChartCard title="Gündəlik girişlər">
          <BarChartSimple
            data={dailySeries.map(d => ({ label: d.day, value: d.entries }))}
            color="#10b981"
          />
        </ChartCard>

        <ChartCard title="Kateqoriya üzrə tədbirlər">
          <BarChartSimple
            data={chartData.eventsByCategory.map(d => ({ label: d.category, value: d.count }))}
            color="#3b82f6"
          />
        </ChartCard>

        <ChartCard title="Aylıq trend">
          <LineChartSimple
            data={chartData.monthlyTrend.map(d => ({
              label: d.month,
