import React, { useState } from 'react';
import {
  ArrowLeft, LayoutDashboard, Building2, Calendar, QrCode, MessageSquare, FileText,
  Users, UserCheck, MapPin, LogIn, Activity, Award, CreditCard, Star, TrendingUp,
  Download, Filter, AlertTriangle, Menu, X, UserPlus
} from 'lucide-react';
import { chartData, youthHouses, events, qrScans, feedbacks, trainers } from '../../data/mockData';
import { useAdminDashboard } from '../../lib/api/admin';
import { RegistrationsPanel } from './RegistrationsPanel';
import { useBackHandler } from '../../lib/backHandler';

interface AdminAppProps {
  onBack: () => void;
}

type Section = 'overview' | 'registrations' | 'houses' | 'events' | 'qr' | 'feedback' | 'reports';

const NAV_ITEMS: { id: Section; label: string; icon: React.ReactNode }[] = [
  { id: 'overview', label: 'Ümumi Baxış', icon: <LayoutDashboard size={18} /> },
  { id: 'registrations', label: 'Qeydiyyatlar', icon: <UserPlus size={18} /> },
  { id: 'houses', label: 'Gənclər Evləri', icon: <Building2 size={18} /> },
  { id: 'events', label: 'Tədbirlər', icon: <Calendar size={18} /> },
  { id: 'qr', label: 'QR Skan Logları', icon: <QrCode size={18} /> },
  { id: 'feedback', label: 'Feedback', icon: <MessageSquare size={18} /> },
  { id: 'reports', label: 'Hesabatlar', icon: <FileText size={18} /> },
];

const PIE_COLORS = ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#64748b'];

const statusColor = (s: string) => {
  if (s === 'Aktiv') return 'bg-emerald-100 text-emerald-700';
  if (s === 'Yüklü') return 'bg-blue-100 text-blue-700';
  if (s === 'Sakit') return 'bg-gray-100 text-gray-600';
  return 'bg-red-100 text-red-700';
};

/* ─── Simple Chart Components ─── */

const BarChartSimple: React.FC<{
  data: { label: string; value: number }[];
  color?: string;
  height?: number;
}> = ({ data, color = '#10b981', height = 260 }) => {
  const max = Math.max(...data.map(d => d.value));
  return (
    <div className="flex items-end gap-2 h-full" style={{ height }}>
      {data.map((d, i) => {
        const pct = max > 0 ? (d.value / max) * 100 : 0;
        return (
          <div key={i} className="flex-1 flex flex-col items-center justify-end h-full group">
            <div className="relative w-full flex justify-center mb-1">
              <span className="absolute -top-6 bg-gray-800 text-white text-xs px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                {d.value.toLocaleString()}
              </span>
            </div>
            <div
              className="w-full max-w-[48px] rounded-t transition-all duration-500 group-hover:opacity-80"
              style={{ height: `${pct}%`, backgroundColor: color, minHeight: pct > 0 ? 4 : 0 }}
            />
            <span className="text-[10px] text-gray-500 mt-1.5 text-center leading-tight truncate w-full px-0.5">{d.label}</span>
          </div>
        );
      })}
    </div>
  );
};

const HorizontalBarChart: React.FC<{
  data: { label: string; value: number }[];
  color?: string;
}> = ({ data, color = '#e11d48' }) => {
  const max = Math.max(...data.map(d => d.value));
  return (
    <div className="space-y-2.5">
      {data.map((d, i) => {
        const pct = max > 0 ? (d.value / max) * 100 : 0;
        return (
          <div key={i} className="group">
            <div className="flex items-center justify-between mb-0.5">
              <span className="text-xs text-gray-600 truncate max-w-[180px]">{d.label}</span>
              <span className="text-xs font-semibold text-gray-700 ml-2">{d.value}</span>
            </div>
            <div className="w-full bg-gray-100 rounded-full h-5 overflow-hidden">
              <div
                className="h-full rounded-full transition-all duration-700"
                style={{ width: `${pct}%`, backgroundColor: color }}
              />
            </div>
          </div>
        );
      })}
    </div>
  );
};

const LineChartSimple: React.FC<{
  data: { label: string; series: { value: number; color: string; name: string }[] }[];
  height?: number;
}> = ({ data, height = 260 }) => {
  const allValues = data.flatMap(d => d.series.map(s => s.value));
  const max = Math.max(...allValues);
  const min = Math.min(...allValues);
  const range = max - min || 1;
  const seriesCount = data[0]?.series.length || 0;
  const legends = data[0]?.series.map(s => ({ name: s.name, color: s.color })) || [];

  return (
    <div style={{ height }}>
      <div className="flex gap-4 mb-3">
        {legends.map((l, i) => (
          <div key={i} className="flex items-center gap-1.5">
            <div className="w-3 h-3 rounded-full" style={{ backgroundColor: l.color }} />
            <span className="text-xs text-gray-600">{l.name}</span>
          </div>
        ))}
      </div>
      <div className="relative" style={{ height: height - 60 }}>
        {/* Y-axis grid lines */}
        {[0, 25, 50, 75, 100].map(pct => (
          <div
            key={pct}
            className="absolute left-0 right-0 border-t border-gray-100"
            style={{ bottom: `${pct}%` }}
          >
            <span className="absolute -left-1 -translate-x-full text-[10px] text-gray-400 -mt-2">
              {Math.round(min + (range * pct) / 100).toLocaleString()}
            </span>
          </div>
        ))}
        {/* SVG lines */}
        <svg className="absolute inset-0 w-full h-full overflow-visible" preserveAspectRatio="none">
          {Array.from({ length: seriesCount }).map((_, si) => {
            const points = data.map((d, di) => {
              const x = data.length > 1 ? (di / (data.length - 1)) * 100 : 50;
              const y = 100 - ((d.series[si].value - min) / range) * 100;
              return `${x},${y}`;
            });
            return (
              <polyline
                key={si}
                points={points.join(' ')}
                fill="none"
                stroke={data[0].series[si].color}
                strokeWidth="2.5"
                strokeLinecap="round"
                strokeLinejoin="round"
                vectorEffect="non-scaling-stroke"
              />
            );
          })}
          {/* Dots */}
          {data.map((d, di) =>
            d.series.map((s, si) => {
              const cx = data.length > 1 ? (di / (data.length - 1)) * 100 : 50;
              const cy = 100 - ((s.value - min) / range) * 100;
              return (
                <circle
                  key={`${di}-${si}`}
                  cx={`${cx}%`}
                  cy={`${cy}%`}
                  r="4"
                  fill="white"
                  stroke={s.color}
                  strokeWidth="2"
                />
              );
            })
          )}
        </svg>
        {/* X labels */}
        <div className="absolute -bottom-5 left-0 right-0 flex justify-between">
          {data.map((d, i) => (
            <span key={i} className="text-[10px] text-gray-500">{d.label}</span>
          ))}
        </div>
      </div>
    </div>
  );
};

const DonutChart: React.FC<{
  data: { label: string; value: number; color: string }[];
  size?: number;
}> = ({ data, size = 160 }) => {
  const total = data.reduce((a, d) => a + d.value, 0);
  const radius = 42;
  const circumference = 2 * Math.PI * radius;
  let accumulated = 0;

  return (
    <div className="flex items-center gap-4">
      <svg width={size} height={size} viewBox="0 0 100 100">
        {data.map((d, i) => {
          const pct = total > 0 ? d.value / total : 0;
          const dashLength = pct * circumference;
          const dashOffset = -accumulated * circumference;
          accumulated += pct;
          return (
            <circle
              key={i}
              cx="50"
              cy="50"
              r={radius}
              fill="none"
              stroke={d.color}
              strokeWidth="14"
              strokeDasharray={`${dashLength} ${circumference - dashLength}`}
              strokeDashoffset={dashOffset}
              transform="rotate(-90 50 50)"
              className="transition-all duration-700"
            />
          );
        })}
        <text x="50" y="48" textAnchor="middle" className="text-[10px] font-bold fill-gray-700">{total.toLocaleString()}</text>
        <text x="50" y="58" textAnchor="middle" className="text-[6px] fill-gray-400">ümumi</text>
      </svg>
      <div className="space-y-1.5">
        {data.map((d, i) => (
          <div key={i} className="flex items-center gap-2">
            <div className="w-3 h-3 rounded-full flex-shrink-0" style={{ backgroundColor: d.color }} />
            <span className="text-xs text-gray-600">{d.label}</span>
            <span className="text-xs font-semibold text-gray-800 ml-auto">{total > 0 ? ((d.value / total) * 100).toFixed(0) : 0}%</span>
          </div>
        ))}
      </div>
    </div>
  );
};

const AdminApp: React.FC<AdminAppProps> = ({ onBack }) => {
  const [section, setSection] = useState<Section>('overview');
  const [mobileNav, setMobileNav] = useState(false);
  const { stats: adminStats, series: dailySeries, loading: statsLoading, error: statsError } = useAdminDashboard();

  useBackHandler(() => {
    if (mobileNav) { setMobileNav(false); return true; }
    if (section !== 'overview') { setSection('overview'); return true; }
    return false;
  });
