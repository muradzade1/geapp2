                }`}>{ev.status}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );

  const renderQR = () => (
    <div className="space-y-4">
      <div className="flex flex-wrap gap-3 items-center">
        <div className="flex items-center gap-2"><Filter size={16} /><span className="text-sm font-medium">Status:</span>
          <select value={qrFilterStatus} onChange={e => setQrFilterStatus(e.target.value)} className="border rounded-lg px-2 py-1 text-sm">
