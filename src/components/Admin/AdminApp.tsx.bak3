              <td className="px-3 py-2 whitespace-nowrap">{ev.date}</td>
              <td className="px-3 py-2 whitespace-nowrap">{ev.startTime}-{ev.endTime}</td>
              <td className="px-3 py-2">{ev.registeredCount}/{ev.capacity}</td>
              <td className="px-3 py-2">{ev.checkedInCount}</td>
              <td className="px-3 py-2">
                <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                  ev.status === 'Davam edir' ? 'bg-green-100 text-green-700' :
                  ev.status === 'Bitib' ? 'bg-gray-100 text-gray-600' :
